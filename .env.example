# ---- Backend (copie estas variáveis para backend/.env) ----

# Connection string do PostgreSQL (ex.: Neon, Supabase, ou instância local)
DATABASE_URL="postgresql://usuario:senha@host/dbname?sslmode=require"

# Porta em que o backend Express vai escutar
PORT=3333

# Segredo usado para assinar os tokens JWT — troque por um valor aleatório longo em produção
JWT_SECRET="troque-este-valor-por-uma-string-aleatoria-longa"

# Tempo de expiração do token de login (ex.: 12h, 1d)
JWT_EXPIRES_IN="12h"

# URL pública do frontend, usada para montar o link de autorização enviado por WhatsApp
FRONTEND_URL="http://localhost:5173"

# Pasta onde a sessão do WhatsApp Web fica salva (não commitar)
WHATSAPP_SESSION_PATH="./whatsapp-session"

# Nome, logo e demais dados da empresa agora são cadastrados pela tela
# Configurações > Dados da Empresa (tabela Empresa no banco), não por env var.

# ---- Frontend (copie para frontend/.env) ----
VITE_API_URL="http://localhost:3333/api"
